          "request": {
            "name": "Get Device History",
            "description": {
              "content": "Paginated, immutable historical time series for the device at the chosen resolution. Use `since` and `until` to bound the window and walk forward or backward; the API clamps the window to its retention policy and truncates minutes, seconds, and milliseconds. Follow the `next` and `prev` cursor links rather than picking arbitrary page sizes.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "homes",
                ":homeId",
                "devices",
                ":deviceId",
                "history"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
